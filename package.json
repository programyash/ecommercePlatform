{
  "name": "chowk-marketplace-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-vendor e-commerce platform with client (Vite + React) and server (Node.js + Express + Prisma + Socket.IO)",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm run server:dev\" \"npm run client:dev\"",
    "client:dev": "npm --prefix client run dev",
    "server:dev": "npm --prefix server run dev",
    "client:build": "npm --prefix client run build",
    "server:build": "npm --prefix server run build",
    "server:test": "npm --prefix server test",
    "server:seed": "npm --prefix server run db:seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
