generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./test.db"
}

enum Role {
  CUSTOMER
  SELLER
  ADMIN
}

enum CustomerStatus {
  ACTIVE
  BLOCKED
}

enum SellerStatus {
  DRAFT
  UNDER_REVIEW
  ACTION_REQUIRED
  ACTIVE
  SUSPENDED
  REJECTED
}

enum ProductStatus {
  DRAFT
  PENDING
  LIVE
  REJECTED
  INACTIVE
  BLOCKED
}

enum PaymentMethod {
  UPI
  CARD
  EMI
  NETBANKING
  WALLET
  COD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  COD_PENDING
  COLLECTED
  REFUND_INITIATED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ShipmentStatus {
  PLACED
  CONFIRMED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  password             String
  role                 Role
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt            DateTime  @default(now())

  customer Customer?
  seller   Seller?
  admin    AdminUser?
}

model Customer {
  id               String           @id @default(uuid())
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  phone            String
  status           CustomerStatus   @default(ACTIVE)
  statusReason     String?
  defaultAddressId String?
  addresses        Address[]
  orders           Order[]
  reviews          Review[]
  savedPayments    SavedPayment[]
}

model Seller {
  id             String         @id @default(uuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug           String         @unique
  displayName    String
  legalName      String
  ownerName      String
  phone          String
  gstin          String?
  pan            String
  city           String
  state          String
  stateCode      String
  pickupAddress  Json
  status         SellerStatus   @default(UNDER_REVIEW)
  statusReason   String?
  rating         Float?
  ratingCount    Int            @default(0)
  tier           String         @default("bronze")
  bank           Json
  tagline        String?
  about          String?
  policies       Json?
  kyc            KycItem[]
  products       Product[]
  shipments      Shipment[]
  payouts        Payout[]
  reviews        Review[]
  joinedAt       DateTime       @default(now())
}

model AdminUser {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  status       String   @default("active")
  roleId       String
  lastActiveAt DateTime @default(now())
}

model Address {
  id         String    @id @default(uuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  phone      String
  line1      String
  line2      String?
  landmark   String?
  city       String
  state      String
  stateCode  String
  pin        String
  type       String    @default("home")
}

model SavedPayment {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  kind       String
  details    Json     // Store network/last4/vpa etc.
  isDefault  Boolean  @default(false)
}

model KycItem {
  id       String  @id @default(uuid())
  sellerId String
  seller   Seller  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  key      String
  label    String
  status   String
  note     String?
  document String?
  required Boolean @default(true)

  @@unique([sellerId, key])
}

model Category {
  id            String     @id @default(uuid())
  slug          String     @unique
  name          String
  parentId      String?
  parent        Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children      Category[] @relation("CategoryHierarchy")
  icon          String
  image         String?
  description   String
  gstRate       Int
  hsnDefault    String
  commissionPct Float
  returnDays    Int
  sortOrder     Int        @default(0)
  facets        Json?
  products      Product[]
}

model Product {
  id              String        @id @default(uuid())
  slug            String        @unique
  title           String
  brand           String
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id])
  sellerId        String
  seller          Seller        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  description     String
  highlights      Json          // Array of strings
  specs           Json          // Array of SpecGroup
  media           Json          // Array of MediaRef
  cover           Json?         // BookCover
  axes            Json          // Array of VariantAxis
  swatches        Json?         // Array of ColourSwatch
  tags            Json?         // Array of ProductTag
  dealEndsAt      DateTime?
  returnDays      Int
  cod             Boolean       @default(true)
  status          ProductStatus @default(DRAFT)
  hsn             String
  gstRate         Int
  dispatchDays    Int
  weightKg        Float
  dimensionsCm    Json          // [number, number, number]
  countryOfOrigin String
  manufacturer    String
  warranty        String?
  keywords        Json?         // Array of strings
  moderation      Json?         // ModerationInfo
  rating          Json?         // Rating object { avg, count, dist }
  variants        Variant[]
  reviews         Review[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Variant {
  id         String      @id @default(uuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String      @unique
  options    Json        // Partial<Record<VariantAxis, string>>
  mrp        Float
  price      Float
  stock      Int
  lowStockAt Int         @default(5)
  active     Boolean     @default(true)
  media      Json?       // Array of MediaRef
  orderItems OrderItem[]
}

model Order {
  id             String       @id // e.g. ORD-123456
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id])
  placedAt       DateTime     @default(now())
  shipTo         Json         // Address snapshot
  billing        Json?        // { gstin, businessName }
  paymentMethod  PaymentMethod
  paymentStatus  PaymentStatus
  paymentAmount  Float
  paymentTxnRef  String?
  paymentDetail  String?
  paymentPaidAt  DateTime?
  paymentFailed  String?      // Failure reason
  couponCode     String?
  couponFundedBy String?
  totals         Json         // OrderTotals { mrp, discount, coupon, shipping, codFee, total }
  notes          Json?        // Array of notes
  shipments      Shipment[]
}

model Shipment {
  id           String         @id // e.g. ORD-123456-1
  orderId      String
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerId     String
  seller       Seller         @relation(fields: [sellerId], references: [id])
  status       ShipmentStatus @default(PLACED)
  cancelledBy  String?
  cancelReason String?
  slaDueAt     DateTime
  promisedBy   DateTime
  deliveredAt  DateTime?
  courier      String?
  awb          String?
  package      Json?          // { weightKg, dimensionsCm }
  events       Json           // Array of TimelineEvent
  totals       Json           // ShipmentTotals { mrp, price, shipping, coupon, total }
  returnId     String?
  payoutId     String?        // Maps to Payout.id
  payout       Payout?        @relation(fields: [payoutId], references: [id])
  items        OrderItem[]
  returnReqs   ReturnRequest[]
}

model OrderItem {
  id           String    @id @default(uuid())
  orderId      String
  shipmentId   String
  shipment     Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  sellerId     String
  productId    String
  variantId    String
  variant      Variant   @relation(fields: [variantId], references: [id])
  title        String    // Snapshot
  variantLabel String    // Snapshot
  image        Json      // MediaRef snapshot
  qty          Int
  mrp          Float
  price        Float
  gstRate      Int
  hsn          String
}

model ReturnRequest {
  id              String    @id // e.g. RET-123
  orderId         String
  shipmentId      String
  shipment        Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  itemIds         Json      // Array of OrderItem IDs
  reason          String
  details         String?
  status          String    // REQUESTED, APPROVED, REJECTED, PICKED_UP, REFUNDED
  requestedAt     DateTime  @default(now())
  decidedAt       DateTime?
  pickedUpAt      DateTime?
  refundedAt      DateTime?
  refundAmount    Float
  refundTo        String
  rejectionReason String?
  escalated       Boolean   @default(false)
}

model Review {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sellerId    String
  seller      Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  rating      Int
  title       String
  body        String
  createdAt   DateTime @default(now())
  verified    Boolean  @default(true)
  helpful     Int      @default(0)
  photos      Json?    // Array of ImageId
  status      String   @default("published")
  flagReason  String?
  sellerReply Json?    // { body, at }
}

model Payout {
  id           String     @id @default(uuid())
  sellerId     String
  seller       Seller     @relation(fields: [sellerId], references: [id])
  periodStart  String     // YYYY-MM-DD
  periodEnd    String
  scheduledFor String
  paidAt       DateTime?
  status       String     // SCHEDULED, PROCESSING, PAID, FAILED, ON_HOLD
  holdReason   String?
  utr          String?
  lines        Json       // Array of PayoutLine
  gross        Float
  net          Float
  shipments    Shipment[]
}

model Coupon {
  code           String   @id
  title          String
  description    String
  kind           String   // FLAT, PERCENT
  value          Float
  maxDiscount    Float?
  minOrder       Float
  categoryIds    Json?    // Array of category IDs
  firstOrderOnly Boolean  @default(false)
  prepaidOnly    Boolean  @default(false)
  fundedBy       String   // PLATFORM, SELLER
  sellerId       String?
  startsAt       DateTime
  endsAt         DateTime
  usageLimit     Int?
  used           Int      @default(0)
  paused         Boolean  @default(false)
}

model AuditEntry {
  id         String   @id @default(uuid())
  at         DateTime @default(now())
  actor      String
  actorName  String
  action     String
  targetType String
  targetId   String
  summary    String
}

model PlatformSettings {
  id                     Int      @id @default(1)
  marketplaceName        String
  supportEmail           String
  freeDeliveryThreshold  Float
  deliveryFee            Float
  expressFee             Float
  codLimit               Float
  codFee                 Float
  defaultReturnDays      Int
  fixedFee               Float
  shippingFeePerShipment Float
  gstOnFeesPct           Float
  tcsPct                 Float
  tdsPct                 Float
  payoutDelayDays        Int
  unserviceablePins      Json     // Array of strings
}
